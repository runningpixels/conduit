node_modules/
dist/
target/
.tauri/
*.tsbuildinfo

# Secrets. Never commit a real environment file; commit .env.example instead.
.env
.env.*
!.env.example

# Phase 6: Tauri updater signing keypair (generated locally / per CI secret).
# The public key is committed inside tauri.conf.json; the private key NEVER.
apps/desktop/src-tauri/.tauri-updater-private.key
apps/desktop/src-tauri/.tauri-updater-private.key.pub

# ts-rs writes relative to the invoking crate dir. Running the export from
# inside crates/<name>/ produces a stray duplicate of packages/config-schema;
# the canonical output is packages/config-schema/src/generated only.
crates/*/packages/

# AI assistant / agent tooling — machine-specific, never part of the project.
.mcp.json
.claude/
.cursor/
.pi/
.pi-subagents/
.pi-scan/

# Local-only working notes, excluded from the public tree.
docs/private/

# Intermediates for scripts/gen-third-party-notices.py. The generated
# THIRD-PARTY-NOTICES.md IS committed; these inputs are not.
about.json
js-licenses.json

# SQLite write-ahead-log sidecars. The .sqlite test fixtures are committed;
# their -wal/-shm companions are transient and regenerate on every open.
*.sqlite-wal
*.sqlite-shm

# Mode B (white-label) build-time emitter output -- see
# docs/private/white-label-plan.md §5, `cargo run --example apply_brand -p
# provider-core`. Purely additive: nothing statically imports these, so a
# stock checkout is unaffected by their absence. (The third emitted file,
# apps/desktop/src/brand/generated.ts, is NOT gitignored -- index.ts imports
# it unconditionally; see that file's own module comment for why it instead
# follows the packages/config-schema/src/generated precedent of shipping
# committed with a stock default.)
packages/ui/src/brand.generated.css
packages/ui/src/fonts/brand-ui.woff2
packages/ui/src/fonts/brand-mono.woff2
packages/ui/src/fonts/brand-serif.woff2

# Phase 6 white-label build outputs (scripts/apply-brand-identity.mjs). Never
# committed: they only exist inside a reseller's own build pipeline, and
# tauri.conf.json.brand-backup is deleted again by --reset.
apps/desktop/branding.build.json
apps/desktop/src-tauri/tauri.conf.json.brand-backup
