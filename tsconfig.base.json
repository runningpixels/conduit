{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@conduit/config-schema": ["./packages/config-schema/src/index.ts"],
      "@conduit/ui": ["./packages/ui/src/index.ts"]
    }
  }
}
